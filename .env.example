# ========================================================
# VARIABLES DE ENTORNO - CONFIGURACIÓN DEL PROYECTO
# ========================================================

# Puerto local del servidor (en Render se asigna automáticamente)
PORT=3000
NODE_ENV=development

# Cadena de conexión segura de Neon PostgreSQL
# Obtenida del panel de control de Neon: https://console.neon.tech
DATABASE_URL=postgresql://neondb_owner:tu_password@ep-ejemplo.neon.tech/neondb?sslmode=require

# Zona horaria para el Cron Job (Argentina UTC-3)
TIMEZONE=America/Argentina/Buenos_Aires

# Clave administrativa para proteger rutas de prueba y administración
ADMIN_KEY=clave_admin_keyberlis_2710

# Alias para regalos en efectivo
ALIAS_REGALO=key.2710

# Contraseña de acceso a la pantalla de administración web (/admin/dashboard)
ADMIN_DASHBOARD_KEY=key27102011
